filegroup {
  name: "NvAudioSvc-srcs",
  srcs: ["app/NvAudioSvc.apk"],
}

filegroup {
  name: "DolbyAudioService-srcs",
  srcs: ["app/DolbyAudioService.apk"],
}

filegroup {
  name: "android.hardware.audio@6.0-service-msd_32-srcs",
  srcs: ["bin32/hw/android.hardware.audio@6.0-service-msd"],
}

cc_defaults {
  name: "android.hardware.audio@6.0-service-msd_32-defaults",
  target: {
    android_arm: {
      srcs: [":android.hardware.audio@6.0-service-msd_32-srcs"],
      shared_libs: ["libcutils", "libhardware", "libhidlbase", "liblog", "libfmq", "libutils", "libmedia_helper", "libaudioutils", "vendor.nvidia.hardware.ipprotect@1.0", "android.hardware.audio@6.0", "android.hardware.audio.common@6.0", "android.hardware.audio.common@6.0-util", "vendor.dolby.audio.measurement@1.0", "vendor.dolby.ms12@1.0", "vendor.dolby.ms12@1.1", "vendor.dolby.ms12@1.2", "libjsoncpp", "libc++", "libc", "libm", "libdl", ],
    },
  },
}

