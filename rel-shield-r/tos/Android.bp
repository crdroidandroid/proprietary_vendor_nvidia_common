filegroup {
  name: "android.hardware.keymaster@3.0-service.tegra_64-srcs",
  srcs: ["bin64/hw/android.hardware.keymaster@3.0-service.tegra"],
}

cc_defaults {
  name: "android.hardware.keymaster@3.0-service.tegra_64-defaults",
  target: {
    android_arm64: {
      srcs: [":android.hardware.keymaster@3.0-service.tegra_64-srcs"],
      shared_libs: ["libkeymaster_shim", "android.hardware.keymaster@3.0", "libbase", "libcutils", "libhidlbase", "libkeymaster_messages", "liblog", "libutils", "libc++", "libc", "libm", "libdl", ],
    },
  },
}

