filegroup {
  name: "vendor.nvidia.hardware.power@1.0-service_32-srcs",
  srcs: ["bin32/hw/vendor.nvidia.hardware.power@1.0-service"],
}

cc_defaults {
  name: "vendor.nvidia.hardware.power@1.0-service_32-defaults",
  target: {
    android_arm: {
      srcs: [":vendor.nvidia.hardware.power@1.0-service_32-srcs"],
      shared_libs: ["liblog", "libutils", "libcutils", "libhardware", "libhidlbase", "android.hardware.power@1.0", "vendor.nvidia.hardware.power@1.0", "libc++", "libc", "libm", "libdl", ],
    },
  },
}

