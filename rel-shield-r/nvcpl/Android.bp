filegroup {
  name: "NvCPLSvc-srcs",
  srcs: ["app/NvCPLSvc/NvCPLSvc.apk"],
}

filegroup {
  name: "vendor.nvidia.hardware.cpl.service@1.0-service_64-srcs",
  srcs: ["bin64/hw/vendor.nvidia.hardware.cpl.service@1.0-service"],
}

cc_defaults {
  name: "vendor.nvidia.hardware.cpl.service@1.0-service_64-defaults",
  target: {
    android_arm64: {
      srcs: [":vendor.nvidia.hardware.cpl.service@1.0-service_64-srcs"],
      shared_libs: ["vendor.nvidia.hardware.cpl.service@1.0", "vendor.nvidia.hardware.cpl.tools@1.0", "vendor.nvidia.hardware.cpl.interfacecb@1.0", "libbase", "libhidlbase", "libbinder", "libcutils", "liblog", "libutils", "libc++", "libc", "libm", "libdl", ],
    },
  },
}

