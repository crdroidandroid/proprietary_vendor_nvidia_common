}

cc_defaults {
  name: "libstagefrighthw_32-defaults",
  target: {
    android_arm: {
      srcs: [":libstagefrighthw_32-srcs"],
      shared_libs: ["libutils", "liblog", "libnvmm_utils", "libc++", "libc", "libm", "libdl", ],
    },
  },
}

