    android_arm64: {
      srcs: [":vendor.nvidia.hardware.ipprotect@1.0-service_64-srcs"],
      shared_libs: ["libutils", "liblog", "libhidlbase", "vendor.nvidia.hardware.ipprotect@1.0", "libc++", "libc", "libm", "libdl", ],
    },
  },
}

