filegroup {
  name: "vendor.nvidia.hardware.ipprotect@1.0-service_64-srcs",
  srcs: ["bin64/hw/vendor.nvidia.hardware.ipprotect@1.0-service"],
}

cc_defaults {
  name: "vendor.nvidia.hardware.ipprotect@1.0-service_64-defaults",
