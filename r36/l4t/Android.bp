filegroup {
  name: "libnvos-l4t_64-srcs",
  srcs: ["lib64/libnvos-l4t.so"],
}

cc_defaults {
  name: "libnvos-l4t_64-defaults",
  target: {
    android_arm64: {
      srcs: [":libnvos-l4t_64-srcs"],
      shared_libs: ["libc.so.6", "ld-linux-aarch64.so.1", ],
    },
  },
}

